//@version=5
indicator("MTF Spread-Exhaustion (directional percentile)", "SpreadExhaust Dir", overlay=false, max_bars_back=1000)

// ============================ Inputs ============================
l1 = input.int(20,  "EMA fast", minval=1, group="EMAs")
l2 = input.int(50,  "EMA 2", minval=1, group="EMAs")
l3 = input.int(100, "EMA 3", minval=1, group="EMAs")
l4 = input.int(200, "EMA slow (denominator)", minval=1, group="EMAs")

prLen = input.int(200, "Percentile lookback (bars)", minval=20, group="Calc",
     tooltip="Lower (~50-100) for trending single stocks; higher (~200-500) for mean-reverting indices.")
upTh  = input.int(85, "Exhaustion |percentile| for count/alert", minval=50, maxval=100, group="Calc")
alignN = input.int(4, "Alert when this many TFs at an extreme", minval=1, maxval=8, group="Calc")
useBandSign = input.bool(true, "Band-based sign (price vs EMA band)", group="Calc",
     tooltip="ON = +1 above the whole EMA band, -1 below it, hold previous sign while inside (seeds at +1).  OFF = legacy EMA20 vs EMA200 crossover sign.")



grp = "Timeframes"

en1 = input.bool(true,  "Show TF1", inline="tf1", group=grp)
tf1 = input.timeframe("5",   "",  inline="tf1", group=grp)

en2 = input.bool(true,  "Show TF2", inline="tf2", group=grp)
tf2 = input.timeframe("15",  "",  inline="tf2", group=grp)

en3 = input.bool(true,  "Show TF3", inline="tf3", group=grp)
tf3 = input.timeframe("30",  "",  inline="tf3", group=grp)

en4 = input.bool(true,  "Show TF4", inline="tf4", group=grp)
tf4 = input.timeframe("60",  "",  inline="tf4", group=grp)

en5 = input.bool(true,  "Show TF5", inline="tf5", group=grp)
tf5 = input.timeframe("120", "",  inline="tf5", group=grp)

en6 = input.bool(true,  "Show TF6", inline="tf6", group=grp)
tf6 = input.timeframe("240", "",  inline="tf6", group=grp)

en7 = input.bool(true,  "Show TF7", inline="tf7", group=grp)
tf7 = input.timeframe("D",   "",  inline="tf7", group=grp)

en8 = input.bool(true,  "Show TF8", inline="tf8", group=grp)
tf8 = input.timeframe("W",   "",  inline="tf8", group=grp)


showDist = input.bool(false, "Show Distance Areas", group="Display")

showAgg = input.bool(true, "Show aggregate (mean) line", group="Display")
showTbl = input.bool(true, "Show table", group="Display")

userange   = input.bool(true, "Range",    inline="t3", group="Timeframes")

// ============ Directional fan-spread percentile (-100..+100) ============
// magnitude = (maxEMA - minEMA) / EMA200 * 100  (stable denominator, always >=0)
// signedPct = sign * percentile(magnitude)
// sign: price outside the EMA band sets it (+1 above / -1 below); inside the band the
// previous sign carries forward, so chop within the ribbon produces no flips. Seed = +1.
f_calc() =>
    e1 = ta.ema(close, l1)
    e2 = ta.ema(close, l2)
    e3 = ta.ema(close, l3)
    e4 = ta.ema(close, l4)
    mx = math.max(e1, e2, e3, e4)
    mn = math.min(e1, e2, e3, e4)
    fan = (mx - mn) / e4 * 100.0          // ribbon width, % of EMA200
    magPct = ta.percentrank(fan, prLen)    // 0..100
    var float bandSgn = 1.0                // seed +1 until price first exits the band
    bandSgn := close > mx ? 1.0 : close < mn ? -1.0 : bandSgn
    sgn = useBandSign ? bandSgn : (e1 >= e4 ? 1.0 : -1.0)
    signedPct = sgn * magPct               // -100..+100
    [signedPct, sgn * fan]                 // also return signed raw width for table

[v5,r5]     = request.security(syminfo.tickerid, tf1,   f_calc())
[v15,r15]   = request.security(syminfo.tickerid, tf2,  f_calc())
[v30,r30]   = request.security(syminfo.tickerid, tf3,  f_calc())
[v60,r60]   = request.security(syminfo.tickerid, tf4,  f_calc())
[v120,r120] = request.security(syminfo.tickerid, tf5, f_calc())
[v240,r240] = request.security(syminfo.tickerid, tf6, f_calc())
[vD,rD]     = request.security(syminfo.tickerid, tf7,   f_calc())
[vW,rW]     = request.security(syminfo.tickerid, tf8,   f_calc())

maxV = math.max(v5,v15,v30,v60,v120,v240,vD,vW)
minV = math.min(v5,v15,v30,v60,v120,v240,vD,vW)
rangeV = math.min(200,maxV - minV)-100

dist_v15 = v15 - math.avg(v30,v60,v120,v240,vD,vW)
dist_v30 = v30 - math.avg(v60,v120,v240,vD,vW)
dist_v60 = v60 - math.avg(v120,v240,vD,vW)
dist_v120 = v120 - math.avg(v240,vD,vW)

// ============================ Colors (shared by lines + table legend) ============================
c5   = #ffffff   // 5m  — bright white (starker)
c15  = #00e5ff   // 15m — electric cyan (starker)
c30  = #26c6da   // 30m
c60  = #42a5f5   // 60m
c120 = #ab47bc   // 120m
c240 = #ffa726   // 240m
cD   = #ffee58   // D
cW   = #ef5350   // W
cRange = #faf4f4

// ============================ Directional lines ============================
plot(en1   ? v5   : na, "5m",   color=color.new(c5,   0),  linewidth=1)
plot(en2  ? v15  : na, "15m",  color=color.new(c15,  0),  linewidth=1)
plot(en3  ? v30  : na, "30m",  color=color.new(c30,  15), linewidth=2)
plot(en4  ? v60  : na, "60m",  color=color.new(c60,  10), linewidth=2)
plot(en5 ? v120 : na, "120m", color=color.new(c120, 0),  linewidth=2)
plot(en6 ? v240 : na, "240m", color=color.new(c240, 0),  linewidth=2)
plot(en7   ? vD   : na, "D",    color=color.new(cD,   0),  linewidth=3)
plot(en8   ? vW   : na, "W",    color=color.new(cW,   0),  linewidth=3)

plot(showDist ? dist_v15 : na , "v15 Distance",   color=color.new(color.silver,85), style = plot.style_area,histbase = 0)
plot(showDist ? dist_v30 : na, "v30 Distance",   color=color.new(color.yellow,90), style = plot.style_area,histbase = 0)
plot(showDist ? dist_v60 : na, "v60 Distance",   color=color.new(color.blue,93), style = plot.style_area,histbase = 0)
plot(showDist ? dist_v120 : na , "v120 Distance",   color=color.new(color.red,96), style = plot.style_area,histbase =0)


cnt = (en1?1:0)+(en2?1:0)+(en3?1:0)+(en4?1:0)+(en5?1:0)+(en6?1:0)+(en7?1:0)+(en8?1:0)
sumV = (en1?nz(v5):0)+(en2?nz(v15):0)+(en3?nz(v30):0)+(en4?nz(v60):0)+(en5?nz(v120):0)+(en6?nz(v240):0)+(en7?nz(vD):0)+(en8?nz(vW):0)
aggV = cnt > 0 ? sumV / cnt : na
//plot(showAgg ? aggV : na, "Aggregate", color=color.new(color.white, 0), linewidth=2, style=plot.style_stepline)

// ============================ Zones ============================
hUp   = hline(85,  "up-exhaustion",   color=color.new(#ef5350, 40), linestyle=hline.style_dashed)
hTop  = hline(100, "", color=color.new(color.gray, 100))
hDn   = hline(-85, "down-exhaustion", color=color.new(#26a69a, 40), linestyle=hline.style_dashed)
hBot  = hline(-100,"", color=color.new(color.gray, 100))
hline(0, "compressed / trendless", color=color.new(color.gray, 60), linestyle=hline.style_dashed, linewidth = 2)
fill(hUp, hTop, color=color.new(#ef5350, 90))
fill(hDn, hBot, color=color.new(#26a69a, 90))

f_up(u,v) => u and not na(v) and v >=  upTh ? 1 : 0
f_dn(u,v) => u and not na(v) and v <= -upTh ? 1 : 0
upCount = f_up(en1,v5)+f_up(en2,v15)+f_up(en3,v30)+f_up(en4,v60)+f_up(en5,v120)+f_up(en6,v240)+f_up(en7,vD)+f_up(en8,vW)
dnCount = f_dn(en1,v5)+f_dn(en2,v15)+f_dn(en3,v30)+f_dn(en4,v60)+f_dn(en5,v120)+f_dn(en6,v240)+f_dn(en7,vD)+f_dn(en8,vW)

// ============================ Table (+ color legend) ============================
// Col 0 = color swatch (matches each line), col 1 = TF name, col 2 = value.
var table t = table.new(position.bottom_right, 3, 10, border_width=1, frame_color=color.new(color.gray,40), frame_width=1)
f_cell(u, v, r) => u ? (na(v) ? "–" : str.tostring(v, "+#;-#") + "   (" + str.tostring(r, "+#.#;-#.#") + "%)") : "off"
f_tcol(v) => na(v) ? color.new(color.gray,80) : v >= upTh ? color.new(#ef5350,25) : v <= -upTh ? color.new(#26a69a,25) : color.new(color.gray,70)
if showTbl and barstate.islast
    table.cell(t, 0, 0, "",            width=1, height=2, bgcolor=color.new(color.gray,25), text_size=size.tiny)
    table.cell(t, 1, 0, "TF",          width=3, height=2, text_color=color.white, bgcolor=color.new(color.gray,25), text_size=size.tiny)
    table.cell(t, 2, 0, "dirPct (w%)", height=2, text_color=color.white, bgcolor=color.new(color.gray,25), text_size=size.tiny)
    us = array.from(en1,en2,en3,en4,en5,en6,en7,en8)
    nm = array.from("5m","15m","30m","60m","120m","240m","D","W")
    vs = array.from(v5,v15,v30,v60,v120,v240,vD,vW)
    rs = array.from(r5,r15,r30,r60,r120,r240,rD,rW)
    cl = array.from(c5,c15,c30,c60,c120,c240,cD,cW)
    for i = 0 to 7
        on = array.get(us,i)
        table.cell(t, 0, i+1, "", width=1, height=2, bgcolor=on ? array.get(cl,i) : color.new(color.gray,80))
        table.cell(t, 1, i+1, array.get(nm,i), width=3, height=2, text_color=color.white, text_size=size.tiny)
        table.cell(t, 2, i+1, f_cell(on, array.get(vs,i), array.get(rs,i)), height=2, text_color=color.white, bgcolor=f_tcol(array.get(vs,i)), text_size=size.tiny)
    table.cell(t, 0, 9, "", width=1, height=2, bgcolor=color.new(color.gray,20))
    table.cell(t, 1, 9, "EXT", width=3, height=2, text_color=color.white, bgcolor=color.new(color.gray,20), text_size=size.tiny)
    table.cell(t, 2, 9, "▲up "+str.tostring(upCount)+"  ▼dn "+str.tostring(dnCount), height=2, text_color=color.white, text_size=size.tiny)

// ============================ Alerts ============================
alertcondition(ta.crossover(math.max(upCount,dnCount), alignN - 0.5), "TFs at extreme", "MTF spread-exhaustion: multiple timeframes at a directional extreme")



// // === Average Absolute Deviation from Mean ===
// f_avgDist(v5, v15, v30, v60, v120, v240, vD, vW) =>
//     n     = 8
//     mean  = (v5 + v15 + v30 + v60 + v120 + v240 + vD + vW) / n
//     sumAD = math.abs(v5 - mean) + math.abs(v15 - mean) + math.abs(v30 - mean) +
//              math.abs(v60 - mean) + math.abs(v120 - mean) + math.abs(v240 - mean) +
//              math.abs(vD - mean) + math.abs(vW - mean)
//     sumAD / n
// avgDistMean     = f_avgDist(v5, v15, v30, v60, v120, v240, vD, vW)
// // === Plots ===
// plot(avgDistMean,     title="Avg Dist (Mean-based)",     color=color.new(color.orange, 0), linewidth=2)
// //plot(avgDistPairwise, title="Avg Dist (Pairwise)",        color=color.new(color.blue, 0),   linewidth=2)


var table wm = table.new(position.top_right, 1, 1)

if barstate.islast
    table.cell(wm, 0, 0, "MTF Spread", text_size=size.huge,
               text_color=color.new(color.gray, 65),
               bgcolor=color.new(color.black,100))




//cond = (v240 < 2 and v240>-2) and (v120 < 2 and v120>-2) and (v60 < 2 and v60>-2)
cond = (vD < -2 and vD>-5) and (v240 < 0 and v240>-3) and (v120 < 4 and v120>-2) and (v60 < 5 and v60>-5) and (v30 >70) and (v15>70) and (v60>v120 and v120>v240 and v240>vD)

bgcolor(cond ? color.new(color.yellow,80 ) : na)
