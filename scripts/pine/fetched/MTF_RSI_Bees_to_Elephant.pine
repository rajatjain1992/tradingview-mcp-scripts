//@version=5
// ══════════════════════════════════════════════════════════════════════
// ADX RAD V2  +  RSI Combo Strategy
// Original indicator code preserved intact.
// Strategy logic added at the bottom — entries/exits based on the
// exact rsi_diff / rsi_diff2 color states already plotted.
// ══════════════════════════════════════════════════════════════════════
indicator("MTF RSI Bees to Elephant", overlay=false)

show_rsi_5m = input.bool(true, "Show RSI 5m")
show_rsi_15m = input.bool(true, "Show RSI 15m")
show_rsi_30m = input.bool(true, "Show RSI 30m")
show_rsi_60m = input.bool(true, "Show RSI 1H")
show_rsi_120m = input.bool(true, "Show RSI 2H")
show_rsi_240m = input.bool(true, "Show RSI 4H")
show_rsi_D = input.bool(true, "Show RSI Daily")
show_rsi_W = input.bool(true, "Show RSI Weekly")


dmiLen = input.int(8, "ADX / DMI Length")
rsiLen = input.int(8, "RSI Length")
DiffInput = input.int(12, "DI Difference Limit")
adx_floor = input.float(20, "ADX Floor")
trend_adx = input.float(23, "MTF Trend Min ADX")



f_5m() =>
    rsi2_local = ta.ema(ta.rsi(close, rsiLen),8)
    rsi2_local

rsi_5m = request.security(syminfo.tickerid, "5", f_5m(), lookahead=barmerge.lookahead_off)
rsi_15m = request.security(syminfo.tickerid, "15", f_5m(), lookahead=barmerge.lookahead_off)
rsi_30m = request.security(syminfo.tickerid, "30", f_5m(), lookahead=barmerge.lookahead_off)
rsi_60m = request.security(syminfo.tickerid, "60", f_5m(), lookahead=barmerge.lookahead_off)
rsi_120m = request.security(syminfo.tickerid, "120", f_5m(), lookahead=barmerge.lookahead_off)
rsi_240m = request.security(syminfo.tickerid, "240", f_5m(), lookahead=barmerge.lookahead_off)
rsi_D = request.security(syminfo.tickerid, "D", f_5m(), lookahead=barmerge.lookahead_off)
rsi_W = request.security(syminfo.tickerid, "W", f_5m(), lookahead=barmerge.lookahead_off)

c5   = #ffffff   // 5m  — bright white (starker)
c15  = #00e5ff   // 15m — electric cyan (starker)
c30  = #26c6da   // 30m
c60  = #42a5f5   // 60m
c120 = #ab47bc   // 120m
c240 = #ffa726   // 240m
cD   = #ffee58   // D
cW   = #ef5350   // W



plot(show_rsi_5m ? rsi_5m : na ,  "RSI 5m", color= color.new(c5, 20), linewidth = 1)
plot(show_rsi_15m ? rsi_15m : na ,  "RSI 15m", color= color.new(c15,20), linewidth = 1)
plot(show_rsi_30m ? rsi_30m : na ,  "RSI 30m", color= color.new(c30,20), linewidth = 2)
plot(show_rsi_60m ? rsi_60m : na ,  "RSI 60m", color= color.new(c60, 20), linewidth = 2)
plot(show_rsi_120m ? rsi_120m : na ,  "RSI 120m", color= color.new(c120, 20), linewidth = 2)
plot(show_rsi_240m ? rsi_240m : na ,  "RSI 240m", color= color.new(c240,20), linewidth = 2)
plot(show_rsi_D ? rsi_D : na ,  "RSI D", color= color.new(cD,20), linewidth = 3)
plot(show_rsi_W ? rsi_W : na ,  "RSI W", color= color.new(cW,20), linewidth = 3)



hline(30,"Oversold Signal Line", linestyle = hline.style_dashed, color = color.green)
hline(70,"Overbought Signal Line", linestyle = hline.style_dashed, color = color.red)
hline(50,"Bullish Signal", linestyle = hline.style_dashed, color = color.white)


var table wm = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(wm, 0, 0, "MTF RSI", text_size=size.huge,
               text_color=color.new(color.gray, 65),
               bgcolor=color.new(color.black,100))
    


cond = rsi_5m> rsi_15m and rsi_15m> rsi_60m and rsi_60m<30 and (rsi_5m>35 and rsi_5m<60) and (rsi_15m>30 and rsi_15m<42)
bgcolor(cond ? color.new(color.yellow,90) : na)