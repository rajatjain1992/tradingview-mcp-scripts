//@version=5
indicator("MTF adx Bees to Elephant", overlay=false)

show_adx_5m = input.bool(true, "Show adx 5m")
show_adx_15m = input.bool(true, "Show adx 15m")
show_adx_30m = input.bool(true, "Show adx 30m")
show_adx_60m = input.bool(true, "Show adx 1H")
show_adx_120m = input.bool(true, "Show adx 2H")
show_adx_240m = input.bool(true, "Show adx 4H")
show_adx_D = input.bool(true, "Show adx Daily")
show_adx_W = input.bool(true, "Show adx Weekly")


dmiLen = input.int(8, "ADX / DMI Length")
DiffInput = input.int(12, "DI Difference Limit")
adx_floor = input.float(5, "ADX Floor")
trend_adx = input.float(23, "MTF Trend Min ADX")


f_5m() =>
    [p5, m5, adx_local] = ta.dmi(dmiLen, dmiLen)
    adx_local

adx_5m = request.security(syminfo.tickerid, "5", f_5m(), lookahead=barmerge.lookahead_off)
adx_15m = request.security(syminfo.tickerid, "15", f_5m(), lookahead=barmerge.lookahead_off)
adx_30m = request.security(syminfo.tickerid, "30", f_5m(), lookahead=barmerge.lookahead_off)
adx_60m = request.security(syminfo.tickerid, "60", f_5m(), lookahead=barmerge.lookahead_off)
adx_120m = request.security(syminfo.tickerid, "120", f_5m(), lookahead=barmerge.lookahead_off)
adx_240m = request.security(syminfo.tickerid, "240", f_5m(), lookahead=barmerge.lookahead_off)
adx_D = request.security(syminfo.tickerid, "D", f_5m(), lookahead=barmerge.lookahead_off)
adx_W = request.security(syminfo.tickerid, "W", f_5m(), lookahead=barmerge.lookahead_off)


c5   = #ffffff   // 5m  — bright white (starker)
c15  = #00e5ff   // 15m — electric cyan (starker)
c30  = #26c6da   // 30m
c60  = #42a5f5   // 60m
c120 = #ab47bc   // 120m
c240 = #ffa726   // 240m
cD   = #ffee58   // D
cW   = #ef5350   // W




plot(show_adx_5m ? adx_5m : na ,  "adx 5m", color= color.new(c5, 20), linewidth = 1)
plot(show_adx_15m ? adx_15m : na ,  "adx 15m", color= color.new(c15,20), linewidth = 1)
plot(show_adx_30m ? adx_30m : na ,  "adx 30m", color= color.new(c30,20), linewidth = 2)
plot(show_adx_60m ? adx_60m : na ,  "adx 60m", color= color.new(c60, 20), linewidth = 2)
plot(show_adx_120m ? adx_120m : na ,  "adx 120m", color= color.new(c120, 20), linewidth = 2)
plot(show_adx_240m ? adx_240m : na ,  "adx 240m", color= color.new(c240,20), linewidth = 2)
plot(show_adx_D ? adx_D : na ,  "adx D",  color= color.new(cD,20), linewidth = 3)
plot(show_adx_W ? adx_W : na ,  "adx W", color= color.new(cW,20), linewidth = 3)

hline(30,"Oversold Signal Line", linestyle = hline.style_dashed, color = color.green)
hline(70,"Overbought Signal Line", linestyle = hline.style_dashed, color = color.red)
hline(50,"Bullish Signal", linestyle = hline.style_dashed, color = color.white)


var table wm = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(wm, 0, 0, "MTF ADX", text_size=size.huge,
               text_color=color.new(color.gray, 65),
               bgcolor=color.new(color.black,100))
    


cond = adx_5m< adx_15m and adx_15m< adx_60m and adx_5m<30 and  (adx_15m>25 and adx_15m<40) and  (adx_60m>55 and adx_60m<70) and (adx_5m - adx_60m)<-30
bgcolor(cond ? color.new(color.yellow,90) : na)